<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Participant List Report Template -->
        <template id="report_participant_list_template">
            <t t-call="web.external_layout">
                <main>
                    <div class="page">
                        <!-- Report title -->
                        <h2 style="text-align: center; margin-bottom: 30px;">
                            Competition Participants Report
                        </h2>
                        <!-- Report generation date -->
                        <p style="text-align: left; margin-bottom: 20px;">
                            <strong>Report Date:</strong>
                            <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M:%S')"/>
                        </p>

                        <table class="table table-striped o_main_table" style="width: 100%; border-collapse: collapse;">
                            <thead>
                                <tr style="background-color: #f8f9fa; border-bottom: 2px solid #dee2e6;">
                                    <th style="padding: 12px; text-align: center; border: 1px solid #dee2e6;">#</th>
                                    <th style="padding: 12px; text-align: left; border: 1px solid #dee2e6;">Registration No.</th>
                                    <th style="padding: 12px; text-align: center; border: 1px solid #dee2e6;">Competition</th>
                                    <th style="padding: 12px; text-align: left; border: 1px solid #dee2e6;">Student</th>
                                    <th style="padding: 12px; text-align: center; border: 1px solid #dee2e6;">Student Code</th>
                                    <th style="padding: 12px; text-align: left; border: 1px solid #dee2e6;">Amount (Juz')</th>
                                    <th style="padding: 12px; text-align: left; border: 1px solid #dee2e6;">Score</th>
                                    <th style="padding: 12px; text-align: right; border: 1px solid #dee2e6;">Office</th>
                                    <th style="padding: 12px; text-align: right; border: 1px solid #dee2e6;">Class</th>
                                    <th style="padding: 12px; text-align: right; border: 1px solid #dee2e6;">Teacher</th>
                                    <th style="padding: 12px; text-align: right; border: 1px solid #dee2e6;">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="docs" t-as="p">
                                    <tr>
                                        <td style="padding: 10px; text-align: center; border: 1px solid #dee2e6;">
                                            <span t-esc="p_index + 1"/>
                                        </td>
                                        <td style="padding: 10px; text-align: left; border: 1px solid #dee2e6;">
                                            <span t-esc="p.name or ''"/>
                                        </td>
                                        <td style="padding: 10px; text-align: center; border: 1px solid #dee2e6;">
                                            <span t-esc="p.competition_id.code or ''"/>
                                        </td>
                                        <td style="padding: 10px; text-align: left; border: 1px solid #dee2e6;">
                                            <span t-esc="p.participant_id.name or ''"/>
                                        </td>
                                        <td style="padding: 10px; text-align: center; border: 1px solid #dee2e6;">
                                            <span t-esc="p.participant_id.ref or ''"/>
                                        </td>
                                        <td style="padding: 10px; text-align: right; border: 1px solid #dee2e6;">
                                            <span t-if="p.amount_juz"
                                                  t-esc="'{:,.2f}'.format(p.amount_juz)"/>
                                            <span t-else="">0.00</span>
                                        </td>
                                        <td style="padding: 10px; text-align: center; border: 1px solid #dee2e6;">
                                            <span t-esc="p.score or 0"/>
                                        </td>
                                        <td style="padding: 10px; text-align: left; border: 1px solid #dee2e6;">
                                            <span t-esc="p.office_id.name or ''"/>
                                        </td>
                                        <td style="padding: 10px; text-align: left; border: 1px solid #dee2e6;">
                                            <span t-esc="p.class_id.name or ''"/>
                                        </td>
                                        <td style="padding: 10px; text-align: left; border: 1px solid #dee2e6;">
                                            <span t-esc="p.teacher_id.name or ''"/>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge badge-"
                                                  t-attf="{'badge-success': p.state == 'inappropriate',
                                                           'badge-warning': p.state == 'confirmed',
                                                           'badge-info': p.state == 'registered',
                                                           'badge-danger': p.state == 'disqualified'}"
                                                  t-esc="p.state"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </main>
            </t>
        </template>
    </data>
</odoo>
