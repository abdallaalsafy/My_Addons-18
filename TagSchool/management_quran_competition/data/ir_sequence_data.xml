<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Competition Sequence -->
        <record id="seq_quran_competition" model="ir.sequence">
            <field name="name">Quran Competition</field>
            <field name="code">quran.competition</field>
            <field name="prefix">QC</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
        
        <!-- Competition Participant Sequence -->
        <record id="seq_quran_competition_participant" model="ir.sequence">
            <field name="name">Quran Competition Participant</field>
            <field name="code">quran.competition.participant</field>
            <field name="prefix">QP</field>
            <field name="padding">6</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
        
        <!-- Competition Requirements Sequence -->
        <record id="seq_competition_requirements" model="ir.sequence">
            <field name="name">Competition Requirements</field>
            <field name="code">competition.requirements</field>
            <field name="prefix">REQ</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
    </data>
</odoo>
