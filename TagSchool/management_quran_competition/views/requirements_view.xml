        <record id="action_competition_requirements_view_id" model="ir.actions.act_window">
            <field name="name">Competition Requirements</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">competition.requirements</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first requirement template
