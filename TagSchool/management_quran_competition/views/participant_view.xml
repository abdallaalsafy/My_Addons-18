<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Quran Competition Participant Form View -->
        <record id="quran_competition_participant_form_view" model="ir.ui.view">
            <field name="name">quran.competition.participant.form</field>
            <field name="model">quran.competition.participant</field>
            <field name="arch" type="xml">
                <form string="Competition Participant">
                    <header>
                        <button name="action_check_participant_eligibility" type="object" string="Validate Requirment"
                            class="btn-danger" invisible="not requirement_id"/>
                        <button name="action_match_level_to_juze_amount" type="object" string="Match Levels"
                            class="btn-primary" invisible="not competition_id"/>
                        <button name="action_evaluate_participant" type="object" string="Evaluate Participant"
                            class="btn-secondary" invisible="not competition_id"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Superior" bg_color="bg-success" invisible="status != 'superior'"/>
                        <widget name="web_ribbon" title="Successful" bg_color="bg-primary" invisible="status != 'successful'"/>
                        <widget name="web_ribbon" title="Acceptable" bg_color="bg-warning" invisible="status != 'acceptable'"/>
                        <widget name="web_ribbon" title="Precipitate" bg_color="bg-danger" invisible="status != 'precipitate'"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                            <h2>
                                <group>
                                    <field name="student_id" options="{'no_quick_create': True}" context="{
                                            'form_view_ref': 'management_quran_office_core.res_partner_form_view_quran_office',
                                            'default_is_student': True}"/>
                                </group>
                            </h2>
                        </div>
                        <group>
                            <group string="Competition Details">
                                <field name="competition_id"/>
                                <field name="registration_number"/>
                            </group>
                            <group string="Registration Information">
                                <field name="registration_date"/>
                                <field name="level_id" invisible="not competition_id"/>
                            </group>
                        </group>
                        <group string="Quran Memorization Details">
                            <group>
                                <field name="memorization_method"/>
                                <field name="juze_amount" readonly="memorization_method == 'mixed'" force_save="1"/>
                                <field name="surah_id" invisible="memorization_method == 'mixed'" 
                                        options="{'no_open':True}" readonly="1" force_save="1"/>
                                <field name="ayah_num" invisible="memorization_method == 'mixed'" readonly="1" force_save="1"/>
                                <field name="surah_ids" options="{'no_open': True, 'no_create': True}"
                                        invisible="memorization_method != 'mixed'" 
                                        required="memorization_method == 'mixed'"
                                        widget="many2many_tags" />
                            </group>
                            <group string="Participant Information">
                                <field name="office_id"/>
                                <field name="class_id" context="{'default_office_id': office_id}"/>
                                <field name="teacher_id" options="{'no_quick_create': True}"
                                       context="{'default_is_teacher': True,
                                       'form_view_ref': 'management_quran_office_core.res_partner_form_view_quran_office'}"/>
                                <field name="age_from_id" force_save="1"/>
                                <field name="age_years" invisible="1"/>
                                <field name="age_months" invisible="1"/>
                                <field name="age_days" invisible="1"/>
                            </group>
                        </group>
                        <group>
                            <group string="Evaluation Results">
                                <field name="score"/>
                                <field name="competition_test_grade"/>
                                <field name="evaluation_percentage" readonly="1" force_save="1"/>
                                <field name="status" invisible="1"/>
                                <field name="result_id" invisible="1"/>
                            </group>
                            <group string="Prize Information">
                                <field name="monetary_prize"/>
                                <field name="in_kind_prize" placeholder="Describe in-kind prize..."/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Notes">
                                <field name="notes" placeholder="Add evaluation notes..."/>
                            </page>
                            <page string="Reason Disqualified" invisible="state != 'disqualified'">
                                <field name="reason_disqualified" placeholder="Reason Disqualified"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Quran Competition Participant Tree View -->
        <record id="quran_competition_participant_tree_view" model="ir.ui.view">
            <field name="name">quran.competition.participant.tree</field>
            <field name="model">quran.competition.participant</field>
            <field name="arch" type="xml">
                <list string="Competition Participants">
                    <header>
                        <button name="action_check_participant_eligibility" type="object" string="Validate Requirment"
                            class="btn-danger"/>
                        <button name="action_match_level_to_juze_amount" type="object" string="Match Levels"
                            class="btn-primary"/>
                        <button name="action_evaluate_participant" type="object" string="Evaluate Participant"
                            class="btn-secondary"/>
                    </header>
                    <field name="name"/>
                    <field name="registration_number" optional="show"/>
                    <field name="student_id"/>
                    <field name="age_from_id"/>
                    <field name="juze_amount"/>
                    <field name="level_id"/>
                    <field name="office_id" optional="show"/>
                    <field name="class_id" optional="show"/>
                    <field name="teacher_id" optional="show"/>
                    <field name="score" optional="show"/>
                    <field name="monetary_prize" optional="show"/>
                    <field name="state" widget="badge" decoration-success="state=='confirmed'" 
                        decoration-warning="state=='disqualified'" decoration-info="state=='draft'" 
                        decoration-danger="state=='withdrawn'"/>
                </list>
            </field>
        </record>

        <!-- Quran Competition Participant Search View -->
        <record id="quran_competition_participant_search_view" model="ir.ui.view">
            <field name="name">quran.competition.participant.search</field>
            <field name="model">quran.competition.participant</field>
            <field name="arch" type="xml">
                <search string="Competition Participants">
                    <field name="student_id" filter_domain="['|',('student_id.name', 'ilike', self),('student_id.ref', 'ilike', self)]"/>
                    <field name="name"/>
                    <field name="registration_number"/>
                    <field name="competition_id"/>
                    <field name="office_id"/>
                    <field name="class_id"/>
                    <field name="teacher_id"/>
                    <field name="level_id"/>

                    <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                    <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                    <filter name="disqualified" string="Disqualified" domain="[('state', '=', 'disqualified')]"/>
                    <filter name="withdrawn" string="Withdrawn" domain="[('state', '=', 'withdrawn')]"/>
                    <separator/>

                    <group expand="0" string="Group By">
                        <filter name="group_student" string="Student" context="{'group_by': 'student_id'}"/>
                        <filter name="group_competition" string="Competition" context="{'group_by': 'competition_id'}"/>
                        <filter name="group_office" string="Office" context="{'group_by': 'office_id'}"/>
                        <filter name="group_class" string="Class" context="{'group_by': 'class_id'}"/>
                        <filter name="group_teacher" string="Teacher" context="{'group_by': 'teacher_id'}"/>
                        <filter name="group_level" string="Level" context="{'group_by': 'level_id'}"/>
                        <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Quran Competition Action -->
        <record id="action_quran_competition_participant_view_id" model="ir.actions.act_window">
            <field name="name">Quran Competitions Participant</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">quran.competition.participant</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Quran competition
                </p>
                <p>
                    Quran competitions help motivate students to improve their memorization
                    and recitation skills while fostering healthy competition.
                </p>
            </field>
        </record>

    </data>
</odoo>
