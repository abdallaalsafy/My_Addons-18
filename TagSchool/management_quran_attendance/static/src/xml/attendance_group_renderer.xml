<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="web.ListRenderer.GroupRow" t-inherit="web.ListRenderer.GroupRow" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('d-flex') and hasclass('align-items-center')]" position="inside">
            <t t-set="attendance_days" t-value="getAttendanceDayNameCells(group)"/>
            <t t-if="attendance_days and attendance_days.length">
                <div class="o_attendance_day_names d-flex flex-wrap gap-1 mt-2">
                    <t t-foreach="attendance_days" t-as="day" t-key="day.number">
                        <span class="small text-muted border rounded px-1" t-esc="day.name"/>
                    </t>
                </div>
            </t>
        </xpath>
    </t>
</templates>
