<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_student_monthly_absence_sheet_wizard_form" model="ir.ui.view">
        <field name="name">student.monthly.absence.sheet.wizard.form</field>
        <field name="model">student.monthly.absence.sheet.wizard</field>
        <field name="arch" type="xml">
            <form string="Monthly Absence Sheet">
                <sheet>
                    <group>
                        <group>
                            <field name="report_date" required="1"/>
                            <field name="holiday_policy_id" required="1"/>
                        </group>
                        <group>
                            <field name="office_id" required="1"/>
                            <field name="teacher_id" required="1"/>
                            <field name="report_orientation" required="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_report" type="object" string="Print" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_student_monthly_absence_sheet_wizard" model="ir.actions.act_window">
        <field name="name">Monthly Absence Sheet</field>
        <field name="res_model">student.monthly.absence.sheet.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
