<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_register_date_wizard_form" model="ir.ui.view">
        <field name="name">attendance.register.date.wizard.form</field>
        <field name="model">attendance.register.date.wizard</field>
        <field name="arch" type="xml">
            <form string="Filter Attendance Register by Date Range">
                <sheet>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_show_records" type="object" string="Show Records" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_attendance_register_date_filter" model="ir.actions.act_window">
        <field name="name">Attendance Register by Date Range</field>
        <field name="res_model">attendance.register.date.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
