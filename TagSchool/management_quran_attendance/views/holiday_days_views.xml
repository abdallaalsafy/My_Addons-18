<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_attendance_month_holiday_tree" model="ir.ui.view">
        <field name="name">attendance.holiday.day.tree</field>
        <field name="model">attendance.holiday.day</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="policy_id"/>
                <field name="holiday_date"/>
                <field name="day_name"/>
                <field name="reason"/>
            </list>
        </field>
    </record>

    <record id="view_attendance_month_holiday_form" model="ir.ui.view">
        <field name="name">attendance.holiday.day.form</field>
        <field name="model">attendance.holiday.day</field>
        <field name="arch" type="xml">
            <form string="Monthly Holiday">
                <sheet>
                    <group>
                        <group>
                            <field name="policy_id"/>
                            <field name="year"/>
                            <field name="month"/>
                        </group>
                        <group>
                            <field name="day_number"/>
                            <field name="day_name"/>
                            <field name="reason"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_attendance_month_holiday" model="ir.actions.act_window">
        <field name="name">Daily Holidays</field>
        <field name="res_model">attendance.holiday.day</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
