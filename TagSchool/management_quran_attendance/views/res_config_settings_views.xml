<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_attendance" model="ir.ui.view">
        <field name="name">attendance.res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="management_quran_office_core.res_config_settings_view_form_quran_core"/>
        <field name="arch" type="xml">
            <xpath expr="//form/app[@name='management_quran_office_core']" position="inside">
                <block title="Quran Attendance Management">
                    <setting id="default_absence_policy" string="Default absence policy" help="Choose the default holiday policy used in new attendance records.">
                        <field name="holiday_policy_id" options="{'no_create': True, 'no_open': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
