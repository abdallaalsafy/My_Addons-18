<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_holiday_policy_tree" model="ir.ui.view">
        <field name="name">attendance.holiday.policy.tree</field>
        <field name="model">attendance.holiday.policy</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="office_id"/>
                <field name="class_id"/>
                <field name="teacher_id"/>
                <field name="is_saturday_off" widget="boolean_toggle"/>
                <field name="is_sunday_off" widget="boolean_toggle"/>
                <field name="is_monday_off" widget="boolean_toggle"/>
                <field name="is_tuesday_off" widget="boolean_toggle"/>
                <field name="is_wednesday_off" widget="boolean_toggle"/>
                <field name="is_thursday_off" widget="boolean_toggle"/>
                <field name="is_friday_off" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_attendance_holiday_policy_form" model="ir.ui.view">
        <field name="name">attendance.holiday.policy.form</field>
        <field name="model">attendance.holiday.policy</field>
        <field name="arch" type="xml">
            <form string="Holiday Policy">
                <header>
                    <button name="action_lock" type="object" string="Lock" class="btn-danger" invisible="is_locked"/>
                    <button name="action_unlock" type="object" string="Unlock" class="btn-success" groups="management_quran_office_core.group_quran_office_manager" invisible="not is_locked"/>
                </header>
                <sheet>
                    <widget  name="web_ribbon"  title="Locked"  bg_color="bg-danger"  invisible="not is_locked"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Holiday Policy Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Policy Duration">
                            <span class="text-muted">👉 Note: The day is not included in the holiday policy.</span>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="office_id"/>
                            <field name="class_id"/>
                            <field name="teacher_id"/>
                        </group>
                        <group string="Weekly Holidays">
                            <field name="is_saturday_off" widget="boolean_toggle"/>
                            <field name="is_sunday_off" widget="boolean_toggle"/>
                            <field name="is_monday_off" widget="boolean_toggle"/>
                            <field name="is_tuesday_off" widget="boolean_toggle"/>
                            <field name="is_wednesday_off" widget="boolean_toggle"/>
                            <field name="is_thursday_off" widget="boolean_toggle"/>
                            <field name="is_friday_off" widget="boolean_toggle"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Exceptional Holidays">
                            <field name="holiday_day_ids">
                                <list editable="bottom">
                                    <field name="holiday_date"/>
                                    <field name="day_name"/>
                                    <field name="reason"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="action_attendance_holiday_policy" model="ir.actions.act_window">
        <field name="name">Holiday Policies</field>
        <field name="res_model">attendance.holiday.policy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
