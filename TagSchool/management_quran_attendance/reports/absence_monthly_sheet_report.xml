<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="student_monthly_sheet">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page" style="direction: rtl; text-align: right;">
                    <h2 class="text-center mb-4">
                        <span>Absence for </span>
                        <span t-esc="month_name"/>
                        <span t-esc="year"/>
                    </h2>

                    <div class="mb-3">
                        <strong>Office:</strong>
                        <span t-esc="office_name or '-'"/>
                        <span class="mx-3"/>
                        <strong>Teacher:</strong>
                        <span t-esc="teacher_name or '-'"/>
                    </div>

                    <table class="table table-sm table-bordered mt-3" style="table-layout: fixed;">
                        <thead>
                            <tr>
                                <th style="width: 45px; text-align: center;">#</th>
                                <th style="width: 100px; text-align: center;">Stu Code</th>
                                <th style="width: 200px;text-align: center;">Student Name</th>
                                <t t-foreach="day_columns" t-as="day">
                                    <th style="width: 20px; text-align: center; vertical-align: middle; font-size: 11px;">
                                        <div><span t-esc="day['day']"/></div>
                                        <strong t-esc="day['weekday']"/>
                                    </th>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="students" t-as="student">
                                <tr>
                                    <td style="text-align: center;" t-esc="student['sequence']"/>
                                    <td style="text-align: center;" t-esc="student['code']"/>
                                    <td t-esc="student['name']"/>
                                    <t t-foreach="student['day_cells']" t-as="cell">
                                        <td style="width: 28px; height: 30px; text-align: center; background-color: #fff;"> </td>
                                    </t>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <p class="mt-4 mb-0 small text-muted" style="font-size: 11px;">
                        <span t-esc="status_hint"/>
                    </p>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_student_monthly_absence_sheet_landscape" model="ir.actions.report">
        <field name="name">Monthly Absence Sheet (Landscape)</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">management_quran_attendance.student_monthly_sheet</field>
        <field name="report_file">management_quran_attendance.student_monthly_sheet</field>
        <field name="print_report_name">'Monthly Absence Sheet' + object.name</field>
        <field name="paperformat_id" ref="paper_report_formats.landscape_A4_list_paperformat"/>
    </record>

    <record id="action_report_student_monthly_absence_sheet_portrait" model="ir.actions.report">
        <field name="name">Monthly Absence Sheet (Portrait)</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">management_quran_attendance.student_monthly_sheet</field>
        <field name="report_file">management_quran_attendance.student_monthly_sheet</field>
        <field name="print_report_name">'Monthly Absence Sheet' + object.name</field>
        <field name="paperformat_id" ref="paper_report_formats.detailed_partner_document_paperformat"/>
    </record>
</odoo>
