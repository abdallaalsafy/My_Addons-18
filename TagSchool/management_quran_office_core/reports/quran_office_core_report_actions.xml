<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Actions for different partner types -->
    
    <!-- Students Academic Report -->
    <record id="action_report_students_academic" model="ir.actions.report">
        <field name="name">Students Academic Report</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">management_quran_office_core.report_student_document</field>
        <field name="report_file">management_quran_office_core.report_student_document</field>
        <field name="print_report_name">'Students Academic Report'</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
        <field name="domain">[('is_student', '=', True), ('is_company', '=', False), ('partner_share', '=', True)]</field>
    </record>

    <!-- Detailed Partner Report -->
    <record id="action_report_detailed_partner" model="ir.actions.report">
        <field name="name">Detailed Partner Report</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">management_quran_office_core.report_detailed_partner_document</field>
        <field name="report_file">management_quran_office_core.report_detailed_partner_document</field>
        <field name="print_report_name">'Detailed Partner Report'</field>
        <field name="paperformat_id" ref="paper_report_formats.detailed_partner_document_paperformat"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
        <field name="domain">[('is_company', '=', False), ('partner_share', '=', True)]</field>
    </record>
    
    <!-- Salaries Or Subscriptions Report -->
    <record id="action_report_salaries_or_subscriptions" model="ir.actions.report">
        <field name="name">Salaries Or Subscriptions Report</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">management_quran_office_core.report_financial_document</field>
        <field name="report_file">management_quran_office_core.report_financial_document</field>
        <field name="print_report_name">'Salaries Or Subscriptions Report'</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
        <field name="domain">[('is_company', '=', False), ('partner_share', '=', True),
                            '|',('is_student', '=', True),('is_teacher', '=', True)]</field>
    </record>
    
    <!-- All Partners Basic Data Report -->
    <record id="action_report_all_partners_basic_data" model="ir.actions.report">
        <field name="name">Partners Basic Data Report</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">management_quran_office_core.report_partner_basic_data_document</field>
        <field name="report_file">management_quran_office_core.report_partner_basic_data_document</field>
        <field name="print_report_name">'Partners Basic Data Report'</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
        <field name="domain">[('is_company', '=', False), ('partner_share', '=', True)]</field>
    </record>
</odoo>
