<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_financial_document">
        <t t-call="web.external_layout">
            <main>
            <div class="page">
                <!-- Dynamic title based on context -->
                <h2 style="text-align: center; margin-bottom: 30px;">
                    <t t-if="context.get('default_is_student')">
                        Students Subscriptions Report
                    </t>
                    <t t-elif="context.get('default_is_teacher')">
                        Teachers Salaries Report
                    </t>
                    <t t-else="">
                        Financial Report
                    </t>
                </h2>
                
                <!-- Report generation date -->
                <p style="text-align: left; margin-bottom: 20px;">
                    <strong>Report Date:</strong> 
                    <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M:%S')"/>
                </p>
                
                <!-- Students Table -->
                <t t-if="context.get('default_is_student')">
                    <table class="table table-striped o_main_table" style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="background-color: #f8f9fa; border-bottom: 2px solid #dee2e6;">
                                <th style="padding: 12px; text-align: center; border: 1px solid #dee2e6;">#</th>
                                <th style="padding: 12px; text-align: left; border: 1px solid #dee2e6;">Student Name</th>
                                <th style="padding: 12px; text-align: center; border: 1px solid #dee2e6;">Age</th>
                                <th style="padding: 12px; text-align: center; border: 1px solid #dee2e6;">Gender</th>
                                <th style="padding: 12px; text-align: left; border: 1px solid #dee2e6;">Phone</th>
                                <th style="padding: 12px; text-align: right; border: 1px solid #dee2e6;">Subscription Fee</th>
                                <th style="padding: 12px; text-align: right; border: 1px solid #dee2e6;">Discount %</th>
                                <th style="padding: 12px; text-align: left; border: 1px solid #dee2e6;">Discount Reason</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="student">
                                <tr>
                                    <td style="padding: 10px; text-align: center; border: 1px solid #dee2e6;">
                                        <span t-esc="student_index + 1"/>
                                    </td>
                                    <td style="padding: 10px; text-align: left; border: 1px solid #dee2e6;">
                                        <span t-esc="student.name or ''"/>
                                    </td>
                                    <td style="padding: 10px; text-align: center; border: 1px solid #dee2e6;">
                                        <span t-esc="student.age_years or 0"/>
                                    </td>
                                    <td style="padding: 10px; text-align: center; border: 1px solid #dee2e6;">
                                        <t t-if="student.gender == 'm'">Male</t>
                                        <t t-elif="student.gender == 'f'">Female</t>
                                        <t t-else="">-</t>
                                    </td>
                                    <td style="padding: 10px; text-align: left; border: 1px solid #dee2e6;">
                                        <span t-esc="student.phone or student.mobile or ''"/>
                                    </td>
                                    <td style="padding: 10px; text-align: right; border: 1px solid #dee2e6;">
                                        <span t-esc="student.subscription_fee or 0"/>
                                    </td>
                                    <td style="padding: 10px; text-align: right; border: 1px solid #dee2e6;">
                                        <span t-esc="student.discount_percentage_fee or 0"/>
                                    </td>
                                    <td style="padding: 10px; text-align: left; border: 1px solid #dee2e6;">
                                        <span t-esc="student.reason_discount_fee or ''"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr style="background-color: #f8f9fa; font-weight: bold;">
                                <td colspan="5" style="padding: 12px; text-align: right; border: 1px solid #dee2e6;">Total:</td>
                                <td style="padding: 12px; text-align: right; border: 1px solid #dee2e6;">
                                    <span t-esc="sum(doc.subscription_fee for doc in docs) or 0"/>
                                </td>
                                <td style="padding: 12px; text-align: right; border: 1px solid #dee2e6;">-</td>
                                <td style="padding: 12px; text-align: left; border: 1px solid #dee2e6;">-</td>
                            </tr>
                        </tfoot>
                    </table>
                </t>
                
                <!-- Teachers Table -->
                <t t-elif="context.get('default_is_teacher')">
                    <table class="table table-striped o_main_table" style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="background-color: #f8f9fa; border-bottom: 2px solid #dee2e6;">
                                <th style="padding: 12px; text-align: center; border: 1px solid #dee2e6;">#</th>
                                <th style="padding: 12px; text-align: left; border: 1px solid #dee2e6;">Teacher Name</th>
                                <th style="padding: 12px; text-align: right; border: 1px solid #dee2e6;">Salary</th>
                                <th style="padding: 12px; text-align: left; border: 1px solid #dee2e6;">Phone</th>
                                <th style="padding: 12px; text-align: left; border: 1px solid #dee2e6;">ID Number</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="teacher">
                                <tr>
                                    <td style="padding: 10px; text-align: center; border: 1px solid #dee2e6;">
                                        <span t-esc="teacher_index + 1"/>
                                    </td>
                                    <td style="padding: 10px; text-align: left; border: 1px solid #dee2e6;">
                                        <span t-esc="teacher.name or ''"/>
                                    </td>
                                    <td style="padding: 10px; text-align: right; border: 1px solid #dee2e6;">
                                        <span t-esc="teacher.teacher_salary or 0"/>
                                    </td>
                                    <td style="padding: 10px; text-align: left; border: 1px solid #dee2e6;">
                                        <span t-esc="teacher.phone or teacher.mobile or ''"/>
                                    </td>
                                    <td style="padding: 10px; text-align: left; border: 1px solid #dee2e6;">
                                        <span t-esc="teacher.id_number or ''"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr style="background-color: #f8f9fa; font-weight: bold;">
                                <td colspan="2" style="padding: 12px; text-align: right; border: 1px solid #dee2e6;">Total Salary:</td>
                                <td style="padding: 12px; text-align: right; border: 1px solid #dee2e6;">
                                    <span t-esc="sum(doc.teacher_salary for doc in docs) or 0"/>
                                </td>
                                <td colspan="2" style="padding: 12px; text-align: left; border: 1px solid #dee2e6;">-</td>
                            </tr>
                        </tfoot>
                    </table>
                </t>
                
                <!-- Summary -->
                <div style="margin-top: 30px; padding: 15px; background-color: #f8f9fa; border-radius: 5px;">
                    <p style="margin: 0; font-weight: bold;">
                        Total Records: <span t-esc="len(docs)"/>
                    </p>
                </div>
            </div>
            </main>
        </t>
    </template>
</odoo>
