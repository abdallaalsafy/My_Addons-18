<?xml version="1.0"?>
<odoo>

    <!-- Quran Office Form View -->
    <record id="quran_office_form_view" model="ir.ui.view">
        <field name="name">quran_office.form</field>
        <field name="model">quran_office.office</field>
        <field name="arch" type="xml">
            <form string="Quran Office">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_students" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="student_count" widget="statinfo" string="Students"/>
                        </button>
                        <button name="action_view_classes" type="object" class="oe_stat_button" icon="fa-graduation-cap">
                            <field name="class_count" widget="statinfo" string="Classes"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Add any additional information about this office..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Quran Office Tree View -->
    <record id="quran_office_tree_view" model="ir.ui.view">
        <field name="name">quran_office.tree</field>
        <field name="model">quran_office.office</field>
        <field name="arch" type="xml">
            <list string="Quran Offices">
                <field name="code" optional="show"/>
                <field name="name"/>
                <field name="student_count" optional="show"/>
                <field name="class_count" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Quran Office Search View -->
    <record id="quran_office_search_view" model="ir.ui.view">
        <field name="name">quran_office.search</field>
        <field name="model">quran_office.office</field>
        <field name="arch" type="xml">
            <search string="Quran Offices">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="code"/>
                <field name="description"/>
                
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/>
                
                <separator/>
                <filter name="with_students" string="With Students" domain="[('student_count', '>', 0)]"/>
                <filter name="without_students" string="Without Students" domain="[('student_count', '=', 0)]"/>
                
                <separator/>
                <filter name="with_classes" string="With Classes" domain="[('class_count', '>', 0)]"/>
                <filter name="without_classes" string="Without Classes" domain="[('class_count', '=', 0)]"/>
                
                <group expand="0" string="Group By">
                    <filter name="group_active" string="Active Status" context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Quran Office Action -->
    <record id="action_quran_offices_view_id" model="ir.actions.act_window">
        <field name="name">Quran Offices</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">quran_office.office</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="quran_office_search_view"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Quran office
            </p>
            <p>
                Quran Offices help you organize students and classes for better management.
                Each office can have multiple classes and students.
            </p>
        </field>
    </record>

</odoo>
