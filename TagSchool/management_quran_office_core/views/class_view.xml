<?xml version="1.0"?>
<odoo>

    <!-- Quran Class Form View -->
    <record id="quran_class_form_view" model="ir.ui.view">
        <field name="name">quran_class.form</field>
        <field name="model">quran_office.class</field>
        <field name="arch" type="xml">
            <form string="Quran Class">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_students" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="student_count" widget="statinfo" string="Students"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="office_id"/>
                            <field name="teacher_id" options="{'no_quick_create': True}" context="{
                                'default_is_teacher': True,
                                'form_view_ref': 'management_quran_office_core.res_partner_form_view_quran_office'}"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Add any additional information about this class..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Quran Class Tree View -->
    <record id="quran_class_tree_view" model="ir.ui.view">
        <field name="name">quran_class.tree</field>
        <field name="model">quran_office.class</field>
        <field name="arch" type="xml">
            <list string="Quran Classes">
                <field name="code" optional="show"/>
                <field name="name"/>
                <field name="office_id" optional="show"/>
                <field name="teacher_id" optional="show"/>
                <field name="student_count" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Quran Class Search View -->
    <record id="quran_class_search_view" model="ir.ui.view">
        <field name="name">quran_class.search</field>
        <field name="model">quran_office.class</field>
        <field name="arch" type="xml">
            <search string="Quran Classes">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="code"/>
                <field name="office_id"/>
                <field name="teacher_id"/>
                <field name="description"/>
                
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/>
                
                <separator/>
                <filter name="with_students" string="With Students" domain="[('student_count', '>', 0)]"/>
                <filter name="without_students" string="Without Students" domain="[('student_count', '=', 0)]"/>
                
                <separator/>
                <filter name="with_teacher" string="With Teacher" domain="[('teacher_id', '!=', False)]"/>
                <filter name="without_teacher" string="Without Teacher" domain="[('teacher_id', '=', False)]"/>
                
                <group expand="0" string="Group By">
                    <filter name="group_office" string="Office" context="{'group_by': 'office_id'}"/>
                    <filter name="group_teacher" string="Teacher" context="{'group_by': 'teacher_id'}"/>
                    <filter name="group_active" string="Active Status" context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Quran Class Action -->
    <record id="action_classes_view_id" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">quran_office.class</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="quran_class_search_view"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first class
            </p>
            <p>
                Classes help you organize students by assigning teachers and managing 
                student groups within each Quran office.
            </p>
        </field>
    </record>

</odoo>
