<?xml version="1.0"?>
<odoo>

    <!-- Area Form View -->
    <record id="area_form_view" model="ir.ui.view">
        <field name="name">area.form</field>
        <field name="model">quran_office.area</field>
        <field name="arch" type="xml">
            <form string="Area/District">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_partners" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="partner_count" widget="statinfo" string="Partners"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Add any additional information about this area..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Area Tree View -->
    <record id="area_tree_view" model="ir.ui.view">
        <field name="name">area.tree</field>
        <field name="model">quran_office.area</field>
        <field name="arch" type="xml">
            <list string="Areas/Districts">
                <field name="code" optional="show"/>
                <field name="name"/>
                <field name="partner_count" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Area Search View -->
    <record id="area_search_view" model="ir.ui.view">
        <field name="name">area.search</field>
        <field name="model">quran_office.area</field>
        <field name="arch" type="xml">
            <search string="Areas/Districts">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="code"/>
                <field name="description"/>
                
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/>
                
                <separator/>
                <filter name="with_partners" string="With Partners" domain="[('partner_count', '>', 0)]"/>
                <filter name="without_partners" string="Without Partners" domain="[('partner_count', '=', 0)]"/>
                
                <group expand="0" string="Group By">
                    <filter name="group_active" string="Active Status" context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

<!-- Area Action -->
    <record id="action_areas_view_id" model="ir.actions.act_window">
        <field name="name">Areas/Districts</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">quran_office.area</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first area/district
            </p>
            <p>
                Areas/Districts help you organize partners by geographical location.
                You can assign partners to specific areas for better management and reporting.
            </p>
        </field>
    </record>

</odoo>
