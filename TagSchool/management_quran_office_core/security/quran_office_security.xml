<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_quran_office" model="ir.module.category">
        <field name="name">Quran Office</field>
        <field name="description">Management access for Quran Office Core</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_quran_office_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_quran_office"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_quran_office_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_quran_office"/>
        <field name="implied_ids" eval="[(4, ref('group_quran_office_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
