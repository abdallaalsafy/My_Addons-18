<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_memorization_document">
        <t t-call="web.external_layout">
            <main>
            <div class="page">
                <!-- Report title -->
                <h2 style="text-align: center; margin-bottom: 30px;">
                    Student Memorization Report
                </h2>
                
                <!-- Report generation date -->
                <p style="text-align: left; margin-bottom: 20px;">
                    <strong>Report Date:</strong> 
                    <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M:%S')"/>
                </p>
                
                <!-- Data table -->
                <table class="table table-striped o_main_table" style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background-color: #f8f9fa; border-bottom: 2px solid #dee2e6;">
                            <th style="padding: 12px; text-align: center; border: 1px solid #dee2e6;">#</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid #dee2e6;">Code</th>
                            <th style="padding: 12px; text-align: center; border: 1px solid #dee2e6;">Month</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid #dee2e6;">Student</th>
                            <th style="padding: 12px; text-align: center; border: 1px solid #dee2e6;">Student Code</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid #dee2e6;">Class</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid #dee2e6;">Teacher</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid #dee2e6;">Surah</th>
                            <th style="padding: 12px; text-align: right; border: 1px solid #dee2e6;">Amount (Juz')</th>
                            <th style="padding: 12px; text-align: right; border: 1px solid #dee2e6;">Grade</th>
                            <th style="padding: 12px; text-align: right; border: 1px solid #dee2e6;">Test</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="docs" t-as="memorization">
                            <tr>
                                <td style="padding: 10px; text-align: center; border: 1px solid #dee2e6;">
                                    <span t-esc="memorization_index + 1"/>
                                </td>
                                <td style="padding: 10px; text-align: left; border: 1px solid #dee2e6;">
                                    <span t-esc="memorization.name or ''"/>
                                </td>
                                <td style="padding: 10px; text-align: center; border: 1px solid #dee2e6;">
                                    <span t-esc="memorization.month_name or ''"/>
                                </td>
                                <td style="padding: 10px; text-align: left; border: 1px solid #dee2e6;">
                                    <span t-esc="memorization.student_id.name or ''"/>
                                </td>
                                <td style="padding: 10px; text-align: center; border: 1px solid #dee2e6;">
                                    <span t-esc="memorization.student_id.ref or ''"/>
                                </td>
                                <td style="padding: 10px; text-align: center; border: 1px solid #dee2e6;">
                                    <span t-esc="memorization.class_id.name or ''"/>
                                </td>
                                <td style="padding: 10px; text-align: center; border: 1px solid #dee2e6;">
                                    <span t-esc="memorization.teacher_id.name or ''"/>
                                </td>
                                <td style="padding: 10px; text-align: left; border: 1px solid #dee2e6;">
                                    <span t-esc="memorization.memorization_surah.name or ''"/>
                                </td>
                                <td style="padding: 10px; text-align: right; border: 1px solid #dee2e6;">
                                    <span t-if="memorization.memorization_amount_juz"
                                          t-esc="'{:,.2f}'.format(memorization.memorization_amount_juz)"/>
                                    <span t-else="">0.00</span>
                                </td>
                                <td style="padding: 10px; text-align: right; border: 1px solid #dee2e6;">
                                    <span t-if="memorization.student_grade"
                                          t-esc="'{:,.1f}'.format(memorization.student_grade)"/>
                                    <span t-else="">0.0</span>
                                </td>
                                <td style="padding: 10px; text-align: right; border: 1px solid #dee2e6;">
                                    <span t-esc="memorization.test_grade or 0"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
                
                <!-- Summary -->
                <div style="margin-top: 30px; padding: 15px; background-color: #f8f9fa; border-radius: 5px;">
                    <p style="margin: 0; font-weight: bold;">
                        Total Records: <span t-esc="len(docs)"/>
                    </p>
                    <p style="margin: 5px 0 0 0; font-weight: bold;">
                        Average Grade: <span t-esc="'{:,.1f}'.format(sum(d.student_grade or 0 for d in docs) / len(docs) if docs else 0)"/>
                    </p>
                    <p style="margin: 5px 0 0 0; font-weight: bold;">
                        Average Test: <span t-esc="'{:,.1f}'.format(sum(d.test_grade or 0 for d in docs) / len(docs) if docs else 0)"/>
                    </p>
                </div>
            </div>
            </main>
        </t>
    </template>
</odoo>
