<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Student Memorization Numbers -->
        <record id="sequence_student_memorization_number" model="ir.sequence">
            <field name="name">Student Memorization Number</field>
            <field name="code">student.memorization.number</field>
            <field name="prefix">MEM-%(year)s%(month)s-</field>
            <field name="padding">6</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
