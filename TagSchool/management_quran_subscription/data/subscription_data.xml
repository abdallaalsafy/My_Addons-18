<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Alternative sequence with different format -->
        <record id="sequence_monthly_subscription_number_alt" model="ir.sequence">
            <field name="name">Monthly Subscription Number Alternative</field>
            <field name="code">monthly.subscription.number.alt</field>
            <field name="prefix">SUB-%(year)s%(month)s-</field>
            <field name="padding">6</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
