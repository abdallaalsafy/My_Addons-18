<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Batch Subscription Wizard Form View -->
        <record id="batch_subscription_wizard_form_view" model="ir.ui.view">
            <field name="name">batch.subscription.wizard.form</field>
            <field name="model">batch.subscription.wizard</field>
            <field name="arch" type="xml">
                <form string="Batch Student Subscription Registration">
                    <sheet>
                        <group>
                            <group string="Subscription Period">
                                <field name="subscription_month"/>
                                <field name="month_name" readonly="1"/>
                            </group>
                            <group string="Information">
                                <p class="text-muted">
                                    This will register subscriptions for all eligible students with subscription fees.
                                    Students must be active, present, and have a subscription fee set.
                                </p>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_register_subscriptions" type="object" string="Batch Register"
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Batch Subscription Wizard Action -->
        <record id="batch_subscription_wizard_action" model="ir.actions.act_window">
            <field name="name">Batch Subscription Registration</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">batch.subscription.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{}</field>
        </record>
    </data>
</odoo>
