<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_subscription_document">
        <t t-call="web.external_layout">
            <main>
            <div class="page">
                <!-- Report title -->
                <h2 style="text-align: center; margin-bottom: 30px;">
                    Student Subscriptions Report
                </h2>
                
                <!-- Report generation date -->
                <p style="text-align: left; margin-bottom: 20px;">
                    <strong>Report Date:</strong> 
                    <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M:%S')"/>
                </p>
                
                <!-- Data table -->
                <table class="table table-striped o_main_table" style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background-color: #f8f9fa; border-bottom: 2px solid #dee2e6;">
                            <th style="padding: 12px; text-align: center; border: 1px solid #dee2e6;">#</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid #dee2e6;">Code</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid #dee2e6;">Voucher</th>
                            <th style="padding: 12px; text-align: left; border: 1px solid #dee2e6;">Student</th>
                            <th style="padding: 12px; text-align: center; border: 1px solid #dee2e6;">Student Code</th>
                            <th style="padding: 12px; text-align: center; border: 1px solid #dee2e6;">Month</th>
                            <th style="padding: 12px; text-align: right; border: 1px solid #dee2e6;">Fee</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="docs" t-as="subscription">
                            <tr>
                                <td style="padding: 10px; text-align: center; border: 1px solid #dee2e6;">
                                    <span t-esc="subscription_index + 1"/>
                                </td>
                                <td style="padding: 10px; text-align: left; border: 1px solid #dee2e6;">
                                    <span t-esc="subscription.name or ''"/>
                                </td>
                                <td style="padding: 10px; text-align: left; border: 1px solid #dee2e6;">
                                    <span t-esc="subscription.payment_voucher_number or ''"/>
                                </td>
                                <td style="padding: 10px; text-align: left; border: 1px solid #dee2e6;">
                                    <span t-esc="subscription.student_id.name or ''"/>
                                </td>
                                <td style="padding: 10px; text-align: center; border: 1px solid #dee2e6;">
                                    <span t-esc="subscription.student_id.ref or ''"/>
                                </td>
                                <td style="padding: 10px; text-align: center; border: 1px solid #dee2e6;">
                                    <span t-esc="subscription.month_name or ''"/>
                                </td>
                                <td style="padding: 10px; text-align: right; border: 1px solid #dee2e6;">
                                    <span t-if="subscription.paid_amount"
                                          t-esc="'{:,.2f}'.format(subscription.paid_amount)"/>
                                    <span t-else="">0.00</span>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
                
                <!-- Summary -->
                <div style="margin-top: 30px; padding: 15px; background-color: #f8f9fa; border-radius: 5px;">
                    <p style="margin: 0; font-weight: bold;">
                        Total Records: <span t-esc="len(docs)"/>
                    </p>
                    <p style="margin: 5px 0 0 0; font-weight: bold;">
                        Total Fee: <span t-esc="'{:,.2f}'.format(sum(d.paid_amount or 0 for d in docs))"/>
                    </p>
                </div>
            </div>
            </main>
        </t>
    </template>



</odoo>
