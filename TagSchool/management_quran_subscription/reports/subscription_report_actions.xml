<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Subscription Report Action -->
    <record id="subscription_report_action" model="ir.actions.report">
        <field name="name">Subscription Report</field>
        <field name="model">monthly.subscription</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">management_quran_subscription.report_subscription_document</field>
        <field name="report_file">management_quran_subscription.report_subscription_document</field>
        <field name="print_report_name">'Subscription Report'</field>
        <field name="binding_model_id" ref="model_monthly_subscription"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paper_report_formats.detailed_partner_document_paperformat"/>
    </record>

    <!-- Subscription Receipt Action -->
    <record id="subscription_receipt_action" model="ir.actions.report">
        <field name="name">Subscription Receipt</field>
        <field name="model">monthly.subscription</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">management_quran_subscription.report_subscription_receipt_document</field>
        <field name="report_file">management_quran_subscription.report_subscription_receipt_document</field>
        <field name="binding_model_id" ref="model_monthly_subscription"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paper_report_formats.paperformat_a5_receipt"/>
        <field name="print_report_name">'Subscription Receipt'</field>
        <field name="multi">False</field>
    </record>
</odoo>
