<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Quran Competition Form View -->
        <record id="quran_competition_form_view" model="ir.ui.view">
            <field name="name">quran.competition.form</field>
            <field name="model">quran.competition</field>
            <field name="arch" type="xml">
                <form string="Quran Competition">
                    <header>
                        <button name="management_quran_competition.action_blank_registration_form_wizard" type="action" string="Blank Registration" class="btn-primary"
                            invisible="status != 'opening'"/>
                        <field name="status" widget="statusbar" statusbar_visible="opening,completed"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_related_participants" type="object" class="oe_stat_button" icon="fa-list"
                                    invisible="participants_count == 0">
                                <field name="participants_count" widget="statinfo" string="Participants"/>
                            </button>
                            <button name="action_view_related_students" type="object" class="oe_stat_button" icon="fa-users"
                                    invisible="participants_count == 0">
                                <field name="participants_count" widget="statinfo" string="Students"/>
                            </button>
                        </div>
                        <div class="oe_title mb24 d-flex align-items-center gap-3" >
                            <h1 class="flex-shrink-0">
                                <field name="name" placeholder="Competition Name"/>
                            </h1>
                            <h2 class="flex-grow-1">
                                <field name="code" readonly="1"/>
                            </h2>
                        </div>
                        <group>
                            <group string="Basic Information">
                                <field name="competition_date"/>
                                <field name="requirement_id"/>
                                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            </group>
                            <group string="Judges &amp; Test Grade">
                                <field name="test_grade"/>
                                <field name="judge_ids" widget="many2many_tags"
                                    options="{'no_create': True, 'no_quick_create': True}"
                                    context="{'default_is_teacher': True, 'form_view_ref': 'management_quran_office_core.res_partner_form_view_quran_office'}"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Levels">
                                <field name="level_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="required_juz"/>
                                        <field name="active" widget="boolean_toggle"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Evaluation Rules">
                                <field name="evaluation_rule_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="result_status"/>
                                        <field name="percentage"/>
                                        <field name="active" widget="boolean_toggle"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Description">
                                <field name="description" nolabel="1" placeholder="Add detailed description about the competition..."/>
                            </page>
                            <page string="Notes">
                                <field name="notes" nolabel="1" placeholder="Add notes about the competition..."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Quran Competition Tree View -->
        <record id="quran_competition_tree_view" model="ir.ui.view">
            <field name="name">quran.competition.tree</field>
            <field name="model">quran.competition</field>
            <field name="arch" type="xml">
                <list string="Quran Competitions">
                    <field name="code" optional="show"/>
                    <field name="name"/>
                    <field name="competition_date"/>
                    <field name="test_grade" optional="show"/>
                    <field name="participants_count" optional="show"/>
                    <field name="status" widget="badge" decoration-success="status=='opening'" 
                        decoration-warning="status=='completed'" decoration-danger="status=='closed'"/>
                </list>
            </field>
        </record>

        <!-- Quran Competition Search View -->
        <record id="quran_competition_search_view" model="ir.ui.view">
            <field name="name">quran.competition.search</field>
            <field name="model">quran.competition</field>
            <field name="arch" type="xml">
                <search string="Quran Competitions">
                    <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                    <field name="code"/>
                    <field name="description"/>
                    
                    <separator/>
                    <filter name="opening" string="Opening" domain="[('status', '=', 'opening')]"/>
                    <filter name="completed" string="Completed" domain="[('status', '=', 'completed')]"/>
                    <filter name="closed" string="Closed" domain="[('status', '=', 'closed')]"/>
                    <separator/>
                    <filter name="with_participants" string="With Participants" domain="[('participants_count', '>', 0)]"/>
                    <filter name="without_participants" string="Without Participants" domain="[('participants_count', '=', 0)]"/>

                    <group expand="0" string="Group By">
                        <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                        <filter name="group_date" string="Competition Date" context="{'group_by': 'competition_date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Quran Competition Action -->
        <record id="action_quran_competition_view_id" model="ir.actions.act_window">
            <field name="name">Quran Competitions</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">quran.competition</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Quran competition
                </p>
                <p>
                    Quran competitions help motivate students to improve their memorization 
                    and recitation skills while fostering healthy competition.
                </p>
            </field>
        </record>
    </data>
</odoo>
