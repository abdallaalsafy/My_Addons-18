<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
         Competition Requirements Form View 
       <record id="competition_requirements_form_view" model="ir.ui.view">
           <field name="name">competition.requirements.form</field>
            <field name="model">competition.requirements</field>
            <field name="arch" type="xml">
                <form string="Competition Requirements">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_related_competitions" type="object" class="oe_stat_button" icon="fa-trophy"
                                    invisible="competition_count == 0">
                                <field name="competition_count" widget="statinfo" string="Competitions"/>
                            </button>
                        </div>
                        <div class="oe_title mb24">
                            <h2>
                                <field name="code" readonly="1"/>
                            </h2>
                            <h1>
                                <field name="name" placeholder="Requirement Template Name"/>
                            </h1>
                        </div>
                        <group col="4">
                             <group cols="1" string="Basic Information">
                                <field name="participant_nums"/>
                            </group>
                            <group string="Description" colspan="3">
                                <field name="description" nolabel="1" placeholder="Add detailed description about the requirements..."/>
                            </group>
                        </group>
                        <notebook colspan="4">
                            <page name="age_requirements" string="Age">
                                <group>
                                    <group>
                                        <field name="min_age"/>
                                        <field name="max_age"/>
                                    </group>
                                </group>
                            </page>
                            <page name="memorization_requirements" string="Memorization">
                                <group col="3">
                                    <group>
                                        <field name="memorization_required"/>
                                    </group>
                                    <group  invisible="not memorization_required or specific_surahs_required">
                                        <field name="min_memorization_amount"/>
                                        <field name="max_memorization_amount" />
                                    </group>
                                    <group invisible="not memorization_required">
                                        <field name="specific_surahs_required"/>
                                        <field name="required_surah_ids" 
                                                widget="many2many_tags" 
                                                invisible="not specific_surahs_required"
                                                options="{'no_open': True,'no_create': True}"/>
                                    </group>
                                </group>
                            </page>
                            <page name="competition_requirements" string="Competitions">
                                <group>
                                    <group>
                                        <field name="registration_status"/>
                                        <field name="highest_level_yet"/>
                                    </group>
                                    <group invisible="not registration_status">
                                        <field name="required_competition_ids" options="{'no_open': True, 'no_create': True}" widget="many2many_tags"/>
                                        <field name="required_tag_ids" options="{'no_open': True, 'no_create': True,'color_field': 'color'}" widget="many2many_tags"/>
                                    </group>
                                </group>
                            </page>
                            <page name="assignment_requirements" string="Assignments">
                                <group>
                                    <group>
                                        <field name="office_ids" widget="many2many_tags"/>
                                        <field name="teacher_ids" widget="many2many_tags"/>
                                    </group>
                                </group>
                            </page>
                            <page name="custom_requirements" string="Custom Requirements">
                                <group>
                                    <group>
                                        <field name="custom_requirements" nolabel="1" placeholder="Add any additional custom requirements..."/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

         Competition Requirements Tree View 
        <record id="competition_requirements_tree_view" model="ir.ui.view">
            <field name="name">competition.requirements.tree</field>
            <field name="model">competition.requirements</field>
            <field name="arch" type="xml">
                <list string="Competition Requirements">
                    <field name="code" optional="show"/>
                    <field name="name"/>
                    <field name="competition_count" optional="show"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="competition_requirements_search_view" model="ir.ui.view">
            <field name="name">competition.requirements.search</field>
            <field name="model">competition.requirements</field>
            <field name="arch" type="xml">
                <search string="Competition Requirements">
                    <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                    <field name="code"/>
                    <field name="description"/>

                    <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                    <filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/>
                    <separator/>
                    <filter name="memorization_required" string="Memorization Required" domain="[('memorization_required', '=', True)]"/>
                    <separator/>
                    <filter name="with_competitions" string="Used in Competitions" domain="[('competition_count', '>', 0)]"/>
                    <filter name="without_competitions" string="Not Used" domain="[('competition_count', '=', 0)]"/>
                   
                   <group expand="0" string="Group By">
                       <filter name="group_active" string="Active Status" context="{'group_by': 'active'}"/>
                   </group>
               </search>
            </field>
        </record>

        <record id="action_competition_requirements_view_id" model="ir.actions.act_window">
            <field name="name">Competition Requirements</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">competition.requirements</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first requirement template
                </p>
                <p>
                    Requirement templates help you define eligibility criteria for competitions.
                    Each competition can use a template to automatically validate participants.
                </p>
            </field>
        </record>

    </data>
</odoo>
