<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="quran_competition_level_form_view" model="ir.ui.view">
            <field name="name">quran.competition.level.form</field>
            <field name="model">quran.competition.level</field>
            <field name="arch" type="xml">
                <form string="Competition Level">
                    <sheet>
                        <div class="oe_title mb24 d-flex align-items-center gap-3" >
                            <h1 class="flex-shrink-0">
                                <field name="name" placeholder="Level Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="competition_id" options="{'no_create': True, 'no_open': True}"/>
                            </group>
                            <group>
                                <field name="required_juz"/>
                            </group>
                        </group>
                        <group string="Notes">
                            <field name="notes" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="quran_competition_level_tree_view" model="ir.ui.view">
            <field name="name">quran.competition.level.tree</field>
            <field name="model">quran.competition.level</field>
            <field name="arch" type="xml">
                <list string="Competition Levels">
                    <field name="name"/>
                    <field name="competition_id"/>
                    <field name="required_juz"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="quran_competition_level_search_view" model="ir.ui.view">
            <field name="name">quran.competition.level.search</field>
            <field name="model">quran.competition.level</field>
            <field name="arch" type="xml">
                <search string="Competition Levels">
                    <field name="name"/>
                    <field name="competition_id"/>
                    <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                    <filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_competition" string="Competition" context="{'group_by': 'competition_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_quran_competition_level_view_id" model="ir.actions.act_window">
            <field name="name">Competition Levels</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">quran.competition.level</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
        </record>
    </data>
</odoo>
