<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Blank Participant Registration Form Template -->
        <template id="report_blank_participant_registration_form_document">
            <t t-call="web.html_container">
                <t t-foreach="range(copies)" t-as="copy">
                    <t t-call="web.external_layout">
                        <div class="page" style="font-size: 15px; color: #1f2937;">
                            <div style="text-align: center; margin-bottom: 20px;">
                                <h2 style="margin: 0; font-weight: bold;">Competition Registration Form</h2>
                            </div>

                            <div style="border: 2px solid #dfe3e8; border-radius: 10px; padding: 20px; margin-bottom: 15px; background-color: #ffffff;">
                                <table style="width: 100%; border-collapse: collapse;">
                                    <tr>
                                        <td style="padding: 8px; width: 20%; font-weight: bold; background-color: #f3f4f6;">Competition Name</td>
                                        <td colspan="3" style="padding: 8px;"><span t-esc="competition_name or ''"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px; font-weight: bold; background-color: #f3f4f6;">Source Registration</td>
                                        <td style="width: 30%;"/>
                                        <td style="padding: 8px; width: 20%; font-weight: bold; background-color: #f3f4f6;">Registration Date</td>
                                        <td style="width: 30%;"/>
                                    </tr>
                                </table>
                            </div>

                            <div style="margin-bottom: 18px;">
                                <h3 style="margin-bottom: 8px; color: #1d4ed8;">Student Information</h3>
                                <table style="width: 100%; border-collapse: collapse;">
                                    <tr>
                                        <td style="padding: 0; vertical-align: top; width: 78%;">
                                            <table style="width: 100%; border-collapse: collapse;">
                                                <tr>
                                                    <td style="padding: 8px; width: 20%; font-weight: bold; background-color: #eff6ff;">Student Name</td>
                                                    <td style="width: 43%;"/>
                                                    <td style="padding: 8px; width: 12%; font-weight: bold; background-color: #eff6ff;">Age</td>
                                                    <td style="width: 25%;"/>
                                                </tr>
                                                <tr>
                                                    <td style="padding: 8px; font-weight: bold; background-color: #eff6ff;">Identity Number</td>
                                                    <td />
                                                    <td style="padding: 8px; font-weight: bold; background-color: #eff6ff;">Date of Birth</td>
                                                    <td/>
                                                </tr>
                                                <tr>
                                                    <td style="padding: 8px; font-weight: bold; background-color: #eff6ff;">Qualification</td>
                                                    <td/>
                                                    <td style="padding: 8px; font-weight: bold; background-color: #eff6ff;">Gender</td>
                                                    <td/>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <div style="margin-bottom: 18px;">
                                <h3 style="margin-bottom: 8px; color: #15803d;">Office and Class Information</h3>
                                <table style="width: 100%; border-collapse: collapse;">
                                    <tr>
                                        <td style="padding: 8px; width: 15%; font-weight: bold; background-color: #ecfdf5;">Office</td>
                                        <td colspan="3"/>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px; font-weight: bold; background-color: #ecfdf5;">Class</td>
                                        <td style="width: 35%;"/>
                                        <td style="padding: 8px; width: 15%; font-weight: bold; background-color: #ecfdf5;">Teacher</td>
                                        <td style="width: 35%;"/>
                                    </tr>
                                </table>
                            </div>

                            <div style="margin-bottom: 18px;">
                                <h3 style="margin-bottom: 8px; color: #b45309;">Memorization Information</h3>
                                <table style="width: 100%; border-collapse: collapse;">
                                    <tr>
                                        <td style="padding: 8px; width: 20%; font-weight: bold; background-color: #fff7ed;">Memorization Type</td>
                                        <td style="padding: 8px; width: 30%; font-weight: bold;border-right: 1px solid white; text-align: left;">From Al-Baqarah</td>
                                        <td style="padding: 8px; width: 20%; font-weight: bold;border-right: 1px solid white;text-align: center;">From An-Nas</td>
                                        <td style="padding: 8px; width: 30%; font-weight: bold; text-align: right;">Mixed</td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px; font-weight: bold; background-color: #fff7ed;">Level</td>
                                        <td/>
                                        <td style="padding: 8px; font-weight: bold; background-color: #fff7ed;">Amount Memorized</td>
                                        <td/>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px; font-weight: bold; background-color: #fff7ed;">Details</td>
                                        <td colspan="3"/>
                                    </tr>
                                </table>
                            </div>

                            <div style="margin-top: 20px; border-top: 2px solid #e5e7eb; padding-top: 15px;">
                                <h4 style="margin-bottom: 10px;">Notes</h4>
                                <div style="min-height: 80px; border: 1px solid #d1d5db; padding: 10px; background-color: #fafafa;"/>
                            </div>

                            <div t-if="copy &lt; copies" style="page-break-after: always;"/>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <!-- Blank Competition Registration Form Action -->
        <record id="report_blank_participant_registration_form" model="ir.actions.report">
            <field name="name">Blank Competition Registration Form</field>
            <field name="model">competition.registration.form.wizard</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">management_quran_competition.report_blank_participant_registration_form_document</field>
            <field name="report_file">management_quran_competition.report_blank_participant_registration_form_document</field>
            <field name="print_report_name">'Blank Registration Form'</field>
            <field name="paperformat_id" ref="management_quran_office_core.detailed_partner_document_paperformat"/>
        </record>
    </data>
</odoo>
