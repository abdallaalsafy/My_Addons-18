<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    
    <t t-inherit="web.ExportDataDialog" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('o_right_field_panel')]" position="before">
        </xpath>
        <xpath expr="//div[hasclass('o_right_field_panel')]" position="after">
            <div class="row mt-3" t-if="this.isPdfFormat">
                <div class="col-12">
                    <label class="fw-bold">عنوان التقرير:</label>
                    <input type="text" class="form-control mt-1" t-model="state.reportTitle" placeholder="أدخل عنوان التقرير" />
                </div>
            </div>
            <div class="row mt-2" t-if="this.isPdfFormat">
                <div class="col-6">
                    <label class="fw-bold">اتجاه التقرير:</label>
                    <select class="form-select mt-1" t-model="state.reportOrientation">
                        <option value="portrait">Portrait</option>
                        <option value="landscape">Landscape</option>
                    </select>
                </div>
                <div class="col-6">
                    <label class="fw-bold">الفهرسة:</label>
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" t-model="state.enableIndexing" />
                        <label class="form-check-label">تفعيل الفهرسة</label>
                    </div>
                </div>
            </div>
        </xpath>
        <xpath expr="//span[hasclass('o_remove_field')]" position="after">
            <t t-if="['float', 'integer', 'monetary'].includes(field.field_type)">
                <select class="form-select form-select-sm float-end" style="width: 80px;" t-if="this.isPdfFormat" t-model="field.aggregate"
                        t-on-click.stop="(ev) => ev.target.focus()"
                        t-on-change="(ev) => this.onToggleFieldSelection(field.id, ev.target.value)">
                    <option value=""/>
                    <option value="sum">Sum</option>
                    <option value="avg">Avg</option>
                    <option value="max">Max</option>
                    <option value="min">Min</option>
                    <option value="count">Count</option>
                </select>
            </t>
        </xpath>
    </t>

</templates>
