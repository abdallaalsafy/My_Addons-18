<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_list_view_landscape" model="report.paperformat">
        <field name="name">List View Landscape</field>
        <field name="default" eval="True" />
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">30</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">25</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_list_view_pdf" model="ir.actions.report">
        <field name="name">List View PDF</field>
        <field name="model">ir.ui.view</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">export_report_pdf.report_list_view</field>
        <field name="report_file">export_report_pdf.report_list_view</field>
        <field name="paperformat_id" ref="paperformat_list_view_landscape"/>
        <field name="print_report_name">'List View - %s' % (object.name if 'name' in object else 'Report')</field>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
